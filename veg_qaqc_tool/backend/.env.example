# ── Vegetation QA/QC API — Environment Configuration ─────────────────────────
# Copy to .env and fill in your values.

# ── Data source ───────────────────────────────────────────────────────────────
# "csv" = read from local CSV files (dev / demo)
# "postgres" = read from SOURCE_DB_URL database (production)
DATA_SOURCE=csv

# ── CSV mode (DATA_SOURCE=csv) ────────────────────────────────────────────────
# Paths to the NS project data folders.
# Defaults point to ../../NS/Data Vegetation relative to this file.
# Override if your data lives elsewhere.
# DATA_DIR=/path/to/Data Vegetation
# ODK_DIR=/path/to/Data Vegetation/ODK Data Exports
# ENT_DIR=/path/to/Data Vegetation/Entity lists

# ── PostgreSQL source (DATA_SOURCE=postgres) ──────────────────────────────────
# Connection string to the NS Analytics database
# SOURCE_DB_URL=postgresql+psycopg2://user:password@host:5432/ns_analytics
# TABLE_SURVEY=herbaceous_veg_survey
# TABLE_QUADRAT=herbaceous_veg_survey_quadrat_repeat
# TABLE_ADDSP=herbaceous_veg_survey_additional_species_repeat
# TABLE_REGISTER_PLOTS=register_vegetation_plots
# TABLE_VEGPLOTS=vegplots
# TABLE_SPECIES=species
# TABLE_SPECIES_EXTRA=species_extra

# ── API database (stores QC run results, flags, narratives) ───────────────────
# SQLite for local dev (no setup needed)
DATABASE_URL=sqlite:///vegqaqc.db
# PostgreSQL for production (Supabase free tier works well)
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/vegqaqc

# ── QC scorecard parameters ───────────────────────────────────────────────────
# These match the SOP defaults. Adjust per project if needed.
MAX_SURVEY_DURATION_MIN=180
MIN_TRANSECT_LENGTH_M=40
MAX_TRANSECT_LENGTH_M=60
MAX_MIDPOINT_DISPLACEMENT_M=25
MAX_QUADRAT_GPS_ACCURACY_M=5
EXPECTED_QUADRATS_PER_SURVEY=20

# ── AI Narrative (Groq) ───────────────────────────────────────────────────────
# Get a free API key at https://console.groq.com
# Leave blank to use the rule-based fallback narrative.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
NARRATIVE_ENABLED=true

# ── CORS ──────────────────────────────────────────────────────────────────────
# Add your Vercel frontend URL in production, e.g.:
# CORS_ORIGINS=["https://veg-qaqc.vercel.app","http://localhost:5173"]
