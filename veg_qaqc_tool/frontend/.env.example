# Static demo mode (default) — reads from /public/data/*.json, no backend needed
VITE_STATIC=true

# Groq AI — powers the AI Insights tab on the Report page
# Get a free key at https://console.groq.com
VITE_GROQ_API_KEY=

# To use a live backend instead:
# VITE_STATIC=false
# VITE_API_URL=https://your-backend.railway.app
